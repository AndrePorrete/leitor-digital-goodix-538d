From: Porrete <56418580+AndrePorrete@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:53:58 -0300
Subject: [PATCH] goodixtls53xd: patient verify and settle delay

Give time to place the finger: the capture waits at least
GOODIX53XD_SETTLE_MS (default 500 ms) after the touch, and still for the
image to stop changing.

Patient verify: when a verify/identify scan fails (no match, light
contact, too strong signal, too few keypoints) with the finger still on
the sensor, scan again as soon as it settles instead of asking to lift
it. The failure is reported after FPRINT_PATIENT_TRIES extra scans
(default 3, 0 = previous behaviour) or FPRINT_PATIENT_SECONDS (default 8),
or when the finger is lifted.
---
 libfprint/drivers/goodixtls/goodix53xd.c |  76 ++++++++++--
 libfprint/fp-image-device-private.h      |   6 +
 libfprint/fpi-image-device.c             | 148 +++++++++++++++++++++++
 libfprint/fpi-image-device.h             |   7 ++
 4 files changed, 230 insertions(+), 7 deletions(-)

diff --git a/libfprint/drivers/goodixtls/goodix53xd.c b/libfprint/drivers/goodixtls/goodix53xd.c
index 7d55b64..3d22f85 100644
--- a/libfprint/drivers/goodixtls/goodix53xd.c
+++ b/libfprint/drivers/goodixtls/goodix53xd.c
@@ -87,6 +87,12 @@
 // that are too light
 #define GOODIX53XD_SETTLE_PERCENT 5 // max delta change between two polls
 #define GOODIX53XD_SETTLE_MAX_POLLS 8
+// Minimum time between the finger touching the sensor and the capture, to
+// give time to place it ($GOODIX53XD_SETTLE_MS overrides, 0 to 3000)
+#define GOODIX53XD_SETTLE_MIN_MS 500
+// Patient verify: after a failed scan with the finger still on the sensor,
+// pause before waiting for it to settle again (see fpi-image-device.c)
+#define GOODIX53XD_REPOSITION_POLLS 3
 #define GOODIX53XD_MIN_CONTACT_DELTA 1900 // $GOODIX53XD_MIN_CONTACT overrides
 // Each image only covers a small part of the finger
 #define GOODIX53XD_ENROLL_STAGES 15
@@ -117,6 +123,7 @@ typedef enum {
     GOODIX53XD_CAPTURE_SETTLE,
     GOODIX53XD_CAPTURE_PRESS,
     GOODIX53XD_CAPTURE_WAIT_FINGER_OFF,
+    GOODIX53XD_CAPTURE_REPOSITION,
 } Goodix53xdCaptureMode;
 
 struct _FpiDeviceGoodixTls53XD {
@@ -149,6 +156,8 @@ struct _FpiDeviceGoodixTls53XD {
   guint last_amplitude;
   guint last_delta;
   guint settle_polls;
+  guint settle_min_polls;
+  guint reposition_polls;
 
   // Debug dumps, see dump_path()
   gchar* dump_session;
@@ -1015,7 +1024,9 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
 
         if (delta <= self->finger_threshold) {
             fp_dbg("Finger lifted before settling, delta: %u", delta);
-            fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_TOO_SHORT);
+            fpi_image_device_report_finger_status(img_dev, FALSE);
+            if (!fpi_image_device_patient_lifted(img_dev))
+                fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_TOO_SHORT);
             self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
             fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
             return;
@@ -1027,7 +1038,8 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
         self->last_delta = delta;
         self->settle_polls++;
 
-        if (!stable && self->settle_polls < GOODIX53XD_SETTLE_MAX_POLLS) {
+        if ((!stable || self->settle_polls < self->settle_min_polls) &&
+            self->settle_polls < self->settle_min_polls + GOODIX53XD_SETTLE_MAX_POLLS) {
             fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
             return;
         }
@@ -1038,8 +1050,10 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
         if (delta < self->min_contact) {
             fp_dbg("Contact too light, delta %u < %u", delta,
                    self->min_contact);
-            fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_CENTER_FINGER);
-            self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
+            if (!fpi_image_device_patient_retry(img_dev, FP_DEVICE_RETRY_CENTER_FINGER)) {
+                fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_CENTER_FINGER);
+                self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
+            }
             fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
             return;
         }
@@ -1082,14 +1096,19 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
             fp_dbg("Signal amplitude %u > %u, asking for another scan",
                    self->last_amplitude, self->max_amplitude);
             g_object_unref(img);
-            fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_REMOVE_FINGER);
+            self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
+            self->dac_offset = self->finger_dac_offset + GOODIX53XD_DETECT_DAC_STEP;
+            // Patient verify: rescan sets the capture mode
+            if (!fpi_image_device_patient_retry(img_dev, FP_DEVICE_RETRY_REMOVE_FINGER))
+                fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_REMOVE_FINGER);
         }
         else {
+            // Set before reporting: a failed match may rescan right away
+            self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
+            self->dac_offset = self->finger_dac_offset + GOODIX53XD_DETECT_DAC_STEP;
             fpi_image_device_image_captured(img_dev, img);
         }
 
-        self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
-        self->dac_offset = self->finger_dac_offset + GOODIX53XD_DETECT_DAC_STEP;
         fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
         return;
 
@@ -1107,9 +1126,46 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
 
         fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
         return;
+
+    case GOODIX53XD_CAPTURE_REPOSITION:
+        // A scan failed with the finger still on: pause, then wait for it
+        // to settle again, without asking to lift it
+        decode_frame(frame, data);
+        delta = frame_delta(frame, self->detect_img);
+
+        if (delta <= self->finger_threshold) {
+            fp_dbg("Finger lifted after a failed scan, delta: %u", delta);
+            fpi_image_device_report_finger_status(img_dev, FALSE);
+            if (!fpi_image_device_patient_lifted(img_dev))
+                fpi_image_device_retry_scan(img_dev, FP_DEVICE_RETRY_TOO_SHORT);
+            self->capture_mode = GOODIX53XD_CAPTURE_WAIT_FINGER_OFF;
+            fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
+            return;
+        }
+
+        if (++self->reposition_polls >= GOODIX53XD_REPOSITION_POLLS) {
+            fp_dbg("Scanning again, delta: %u", delta);
+            self->last_delta = delta;
+            self->settle_polls = 0;
+            self->capture_mode = GOODIX53XD_CAPTURE_SETTLE;
+        }
+        fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
+        return;
     }
 }
 
+// Patient verify (fpi-image-device.c): capture again with the finger on
+static void dev_patient_rescan(FpImageDevice* img_dev)
+{
+    FpiDeviceGoodixTls53XD* self = FPI_DEVICE_GOODIXTLS53XD(img_dev);
+
+    g_slist_free_full(self->frames, g_free);
+    self->frames = NULL;
+    self->reposition_polls = 0;
+    self->capture_mode = GOODIX53XD_CAPTURE_REPOSITION;
+    self->dac_offset = self->finger_dac_offset + GOODIX53XD_DETECT_DAC_STEP;
+}
+
 enum scan_empty_img_state {
     SCAN_EMPTY_NAV0,
     SCAN_EMPTY_GET_IMG,
@@ -1385,6 +1441,11 @@ static void fpi_device_goodixtls53xd_init(FpiDeviceGoodixTls53XD* self)
                               ? (guint) g_ascii_strtoull(max_amplitude, NULL, 10)
                               : GOODIX53XD_MAX_AMPLITUDE;
 
+    const gchar* settle_ms = g_getenv("GOODIX53XD_SETTLE_MS");
+    guint64 ms = GOODIX53XD_SETTLE_MIN_MS;
+    if (settle_ms != NULL && *settle_ms != '\0')
+        ms = MIN(g_ascii_strtoull(settle_ms, NULL, 10), 3000);
+    self->settle_min_polls = (guint) (ms / GOODIX53XD_POLL_DELAY);
 }
 
 static void fpi_device_goodixtls53xd_class_init(
@@ -1416,6 +1477,7 @@ static void fpi_device_goodixtls53xd_class_init(
   // matching scans being added to it
   img_dev_class->sigfm_learn_max = GOODIX53XD_TEMPLATE_MAX; // com trava FPRINT_LEARN_MIN (fpi-image-device.c)
   img_dev_class->sigfm_min_keypoints = GOODIX53XD_MIN_KEYPOINTS;
+  img_dev_class->patient_rescan = dev_patient_rescan;
   // SIGFM score threshold. Offline, impostors never scored above 3 once the
   // fixed pattern of the sensor is removed by the calibration
   img_dev_class->bz3_threshold = 60; // correlação coerente x blocos x100 (dedo errado máx. 51 nos testes)
