+/* Patient verify: when a verify or identify scan fails (no match, or a
+ * condition that would ask to lift the finger) while the finger is still on
+ * the sensor, drivers implementing patient_rescan capture again as soon as
+ * the finger settles, instead of reporting the failure. The failure is only
+ * reported after $FPRINT_PATIENT_TRIES extra scans (default 3, 0 disables)
+ * or $FPRINT_PATIENT_SECONDS (default 8) since the first failure. */
+#define FP_IMAGE_DEVICE_PATIENT_TRIES 3
+#define FP_IMAGE_DEVICE_PATIENT_SECONDS 8
+
+static guint
+fp_image_device_env_uint (const gchar *name, guint fallback, guint max)
+{
+  const gchar *env = g_getenv (name);
+  gchar *end = NULL;
+  guint64 v;
+
+  if (env == NULL || *env == '\0')
+    return fallback;
+  v = g_ascii_strtoull (env, &end, 10);
+  if (end == env)
+    return fallback;
+  return (guint) MIN (v, max);
+}
+
+static gboolean
+fp_image_device_patient_rescan (FpImageDevice *self, gboolean is_retry,
+                                FpDeviceRetry retry)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpImageDeviceClass *cls = FP_IMAGE_DEVICE_GET_CLASS (self);
+  FpiDeviceAction action = fpi_device_get_current_action (FP_DEVICE (self));
+  guint tries;
+  gint64 now;
+
+  if (cls->patient_rescan == NULL)
+    return FALSE;
+  if (action != FPI_DEVICE_ACTION_VERIFY && action != FPI_DEVICE_ACTION_IDENTIFY)
+    return FALSE;
+  if (!priv->active || !priv->finger_present)
+    return FALSE;
+  if (priv->state != FPI_IMAGE_DEVICE_STATE_CAPTURE &&
+      priv->state != FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF)
+    return FALSE;
+  if (g_cancellable_is_cancelled (fpi_device_get_cancellable (FP_DEVICE (self))))
+    return FALSE;
+
+  tries = fp_image_device_env_uint ("FPRINT_PATIENT_TRIES",
+                                    FP_IMAGE_DEVICE_PATIENT_TRIES, 20);
+  now = g_get_monotonic_time ();
+  if (priv->patient_attempts == 0)
+    priv->patient_deadline = now +
+      (gint64) fp_image_device_env_uint ("FPRINT_PATIENT_SECONDS",
+                                         FP_IMAGE_DEVICE_PATIENT_SECONDS, 60) *
+      G_USEC_PER_SEC;
+
+  if (priv->patient_attempts >= tries || now >= priv->patient_deadline)
+    {
+      if (tries > 0)
+        g_message ("Patient verify: giving up after %u extra scans",
+                   priv->patient_attempts);
+      return FALSE;
+    }
+
+  priv->patient_attempts++;
+  priv->patient_last_retry = is_retry;
+  priv->patient_last_retry_code = retry;
+  g_message ("Patient verify: scan failed (%s), scanning again while the finger stays (%u/%u)",
+             is_retry ? "retry" : "no match", priv->patient_attempts, tries);
+
+  if (priv->state == FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF)
+    fp_image_device_change_state (self, FPI_IMAGE_DEVICE_STATE_CAPTURE);
+  cls->patient_rescan (self);
+  return TRUE;
+}
+
 static void
 fpi_image_device_minutiae_detected (GObject *source_object, GAsyncResult *res, gpointer user_data)
 {
@@ -387,6 +466,15 @@ fpi_image_device_minutiae_detected (GObject *source_object, GAsyncResult *res, g
           result = FPI_MATCH_ERROR;
         }
 
+      if (result != FPI_MATCH_SUCCESS &&
+          (!error || error->domain == FP_DEVICE_RETRY) &&
+          fp_image_device_patient_rescan (self, error != NULL,
+                                          error ? error->code : FP_DEVICE_RETRY_GENERAL))
+        {
+          g_clear_error (&error);
+          return;
+        }
+
       if (!error || error->domain == FP_DEVICE_RETRY)
         fpi_device_verify_report (device, result, g_steal_pointer (&print), g_steal_pointer (&error));
 
@@ -419,6 +507,15 @@ fpi_image_device_minutiae_detected (GObject *source_object, GAsyncResult *res, g
             }
         }
 
+      if (result == NULL &&
+          (!error || error->domain == FP_DEVICE_RETRY) &&
+          fp_image_device_patient_rescan (self, error != NULL,
+                                          error ? error->code : FP_DEVICE_RETRY_GENERAL))
+        {
+          g_clear_error (&error);
+          return;
+        }
+
       if (!error || error->domain == FP_DEVICE_RETRY)
         fpi_device_identify_report (device, result, g_steal_pointer (&print), g_steal_pointer (&error));
 
@@ -582,6 +679,57 @@ fpi_image_device_image_captured (FpImageDevice *self, FpImage *image)
   fp_image_device_change_state (self, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
 }
 
+/**
+ * fpi_image_device_patient_retry:
+ * @self: a #FpImageDevice imaging fingerprint device
+ * @retry: The #FpDeviceRetry the driver would report
+ *
+ * For drivers implementing patient_rescan: called instead of
+ * fpi_image_device_retry_scan() while the finger is on the sensor. Returns
+ * %TRUE when the scan is taken again (patient_rescan was called); %FALSE
+ * when the driver must report the retry as usual.
+ */
+gboolean
+fpi_image_device_patient_retry (FpImageDevice *self, FpDeviceRetry retry)
+{
+  return fp_image_device_patient_rescan (self, TRUE, retry);
+}
+
+/**
+ * fpi_image_device_patient_lifted:
+ * @self: a #FpImageDevice imaging fingerprint device
+ *
+ * For drivers implementing patient_rescan: the finger was lifted before a
+ * scan taken again. Reports the last failure and returns %TRUE; returns
+ * %FALSE when no scan was taken again (the driver reports as usual).
+ */
+gboolean
+fpi_image_device_patient_lifted (FpImageDevice *self)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpiDeviceAction action = fpi_device_get_current_action (FP_DEVICE (self));
+
+  if (priv->patient_attempts == 0 || !priv->active ||
+      priv->state != FPI_IMAGE_DEVICE_STATE_CAPTURE ||
+      (action != FPI_DEVICE_ACTION_VERIFY && action != FPI_DEVICE_ACTION_IDENTIFY))
+    return FALSE;
+
+  g_message ("Patient verify: finger lifted, reporting the last failure");
+  if (priv->patient_last_retry)
+    {
+      fpi_image_device_retry_scan (self, priv->patient_last_retry_code);
+      return TRUE;
+    }
+
+  if (action == FPI_DEVICE_ACTION_VERIFY)
+    fpi_device_verify_report (FP_DEVICE (self), FPI_MATCH_FAIL, NULL, NULL);
+  else
+    fpi_device_identify_report (FP_DEVICE (self), NULL, NULL, NULL);
+  fp_image_device_maybe_complete_action (self, NULL);
+  fpi_image_device_deactivate (self, TRUE);
+  return TRUE;
+}
+
 /**
  * fpi_image_device_retry_scan:
  * @self: a #FpImageDevice imaging fingerprint device
diff --git a/libfprint/fpi-image-device.h b/libfprint/fpi-image-device.h
index 3147a71..36b6609 100644
--- a/libfprint/fpi-image-device.h
+++ b/libfprint/fpi-image-device.h
@@ -123,6 +123,10 @@ struct _FpImageDeviceClass
   void                    (*change_state) (FpImageDevice      *dev,
                                            FpiImageDeviceState state);
   void                    (*deactivate)   (FpImageDevice *dev);
+
+  /* Optional: capture again without waiting for the finger to be lifted
+   * (patient verify, see fpi_image_device_patient_retry()) */
+  void                    (*patient_rescan) (FpImageDevice *dev);
 };
 
 void fpi_image_device_set_bz3_threshold (FpImageDevice *self,
@@ -144,5 +148,8 @@ void fpi_image_device_report_finger_status (FpImageDevice *self,
                                             gboolean       present);
 void fpi_image_device_image_captured (FpImageDevice *self,
                                       FpImage       *image);
+gboolean fpi_image_device_patient_retry (FpImageDevice *self,
+                                         FpDeviceRetry  retry);
+gboolean fpi_image_device_patient_lifted (FpImageDevice *self);
 void fpi_image_device_retry_scan (FpImageDevice *self,
                                   FpDeviceRetry  retry);
