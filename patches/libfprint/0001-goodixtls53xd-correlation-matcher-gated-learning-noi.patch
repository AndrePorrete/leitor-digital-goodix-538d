+// Comparador por correlação alinhada (sensores pequenos, cristas quase paralelas):
+// o SIGFM aceita dedos diferentes porque listras paralelas têm geometria parecida.
+// Aqui a região central de uma imagem é girada (-30..30 graus) e procurada na
+// outra; a nota é a maior correlação normalizada x100 (0..100), simétrica.
+namespace {
+cv::Mat ncc_prep(const cv::Mat& u8)
+{
+    cv::Mat f, a, b;
+    u8.convertTo(f, CV_32F);
+    cv::medianBlur(f, f, 3);
+    cv::GaussianBlur(f, a, cv::Size(0, 0), 1.0);
+    cv::GaussianBlur(f, b, cv::Size(0, 0), 4.0);
+    f = a - b;
+    cv::Scalar mean, sd;
+    cv::meanStdDev(f, mean, sd);
+    f = (f - mean[0]) / (sd[0] + 1e-9);
+    return f;
+}
+
+struct ncc_hit {
+    double score;
+    int dx, dy;
+};
+
+// Região central de a girada de ang graus, procurada em b
+ncc_hit ncc_dir(const cv::Mat& a, const cv::Mat& b, int ang)
+{
+    const int H = a.rows, W = a.cols;
+    const int ch = H * 6 / 10, cw = W * 6 / 10;
+    const int y0 = (H - ch) / 2, x0 = (W - cw) / 2;
+    cv::Mat pad, ar, res;
+    cv::copyMakeBorder(b, pad, ch / 2, ch / 2, cw / 2, cw / 2,
+                       cv::BORDER_CONSTANT, cv::Scalar(0));
+    cv::Mat R = cv::getRotationMatrix2D(cv::Point2f(W / 2.0f, H / 2.0f), ang, 1.0);
+    cv::warpAffine(a, ar, R, a.size());
+    cv::matchTemplate(pad, ar(cv::Rect(x0, y0, cw, ch)), res, cv::TM_CCOEFF_NORMED);
+    double mx;
+    cv::Point loc;
+    cv::minMaxLoc(res, nullptr, &mx, nullptr, &loc);
+    return {mx, loc.x - cw / 2 - x0, loc.y - ch / 2 - y0};
+}
+
+// Concordância local depois de alinhar: 1º quartil da correlação em blocos 12x12
+double block_q25(const cv::Mat& a, const cv::Mat& b, int ang, int dx, int dy)
+{
+    const int H = a.rows, W = a.cols, bs = 12;
+    cv::Mat R = cv::getRotationMatrix2D(cv::Point2f(W / 2.0f, H / 2.0f), ang, 1.0);
+    R.at<double>(0, 2) += dx;
+    R.at<double>(1, 2) += dy;
+    cv::Mat aw, mask;
+    cv::warpAffine(a, aw, R, a.size());
+    cv::warpAffine(cv::Mat::ones(a.size(), CV_32F), mask, R, a.size());
+    std::vector<double> v;
+    for (int y = 0; y + bs <= H; y += bs / 2) {
+        for (int x = 0; x + bs <= W; x += bs / 2) {
+            const cv::Rect r(x, y, bs, bs);
+            cv::Mat m = mask(r) > 0.99f;
+            if (cv::countNonZero(m) < 0.95 * bs * bs) {
+                continue;
+            }
+            cv::Mat u = aw(r) - cv::mean(aw(r))[0];
+            cv::Mat w = b(r) - cv::mean(b(r))[0];
+            const double den = cv::norm(u) * cv::norm(w) + 1e-9;
+            v.push_back(u.dot(w) / den);
+        }
+    }
+    if (v.size() < 6) {
+        return 0;
+    }
+    std::sort(v.begin(), v.end());
+    const double pos = 0.25 * (v.size() - 1);
+    const size_t i = (size_t) pos;
+    const double f = pos - i;
+    return i + 1 < v.size() ? v[i] * (1 - f) + v[i + 1] * f : v[i];
+}
+} // namespace
+
+// Nota = melhor correlação coerente (giro de até 15 graus, o mesmo nos dois
+// sentidos) x concordância local em blocos. Dedos diferentes com sulcos
+// parecidos alinham no conjunto mas falham nos blocos.
+static int ncc_match_score(const cv::Mat& x, const cv::Mat& y)
+{
+    if (x.size() != y.size()) {
+        return 0;
+    }
+    const cv::Mat a = ncc_prep(x), b = ncc_prep(y);
+    double best = -1;
+    ncc_hit best_hit{0, 0, 0};
+    int best_ang = 0;
+    for (int ang = -15; ang <= 15; ang += 3) {
+        const ncc_hit f = ncc_dir(a, b, ang);
+        const ncc_hit r = ncc_dir(b, a, -ang);
+        const double s = (f.score + r.score) / 2;
+        if (s > best) {
+            best = s;
+            best_hit = f;
+            best_ang = ang;
+        }
+    }
+    const double q25 = block_q25(a, b, best_ang, best_hit.dx, best_hit.dy);
+    return std::max(0, (int) std::lround(best * std::max(q25, 0.0) * 100));
+}
+
 int sigfm_match_score(SigfmImgInfo* frame, SigfmImgInfo* enrolled)
 {
+    if (!frame->image.empty() && !enrolled->image.empty()) {
+        try {
+            return ncc_match_score(frame->image, enrolled->image);
+        }
+        catch (...) {
+            return -1;
+        }
+    }
     try {
         std::vector<std::vector<cv::DMatch>> points;
         auto bfm = cv::BFMatcher::create();
