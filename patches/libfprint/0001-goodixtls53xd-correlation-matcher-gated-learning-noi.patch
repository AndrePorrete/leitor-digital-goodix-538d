--- a/libfprint/fpi-image-device.c
+++ b/libfprint/fpi-image-device.c
@@ -245,6 +245,18 @@ fp_image_device_maybe_learn (FpImageDevice *self, FpPrint *template, FpPrint *pr
   if (priv->algorithm != FPI_PRINT_SIGFM || cls->sigfm_learn_max == 0)
     return;
 
+  /* Trava: só aprende toques com nota bem acima do limiar, para nunca
+   * incorporar um dedo errado aceito por pouco ($FPRINT_LEARN_MIN, padrão 75) */
+  {
+    const gchar *env = g_getenv ("FPRINT_LEARN_MIN");
+    gint learn_min = env ? (gint) g_ascii_strtoll (env, NULL, 10) : 75;
