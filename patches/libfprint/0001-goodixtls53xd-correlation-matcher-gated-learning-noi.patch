From 24653e25aed16cd8a4a7c9ad36962b2f645ab4ac Mon Sep 17 00:00:00 2001
From: Porrete <56418580+AndrePorrete@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:28:54 -0300
Subject: [PATCH] goodixtls53xd: correlation matcher, gated learning, noise
 recalibration (Inspiron 5590)

- sigfm: store the 8-bit press image in the print; when both images exist,
  score = coherent rotation NCC (+-15 deg, theta / -theta) x 25th percentile
  of 12x12 block correlations, x100. SIFT/SIGFM only as fallback.
- fpi-print: best score over all template images, exposed through
  fpi_print_sigfm_last_score().
- fpi-image-device: learn only when best score >= FPRINT_LEARN_MIN (75).
- fp-image-device: FPRINT_BZ3_THRESHOLD env override.
- goodix53xd: recalibrate when the noise frame has a finger (hang fix),
  15 enroll stages, threshold 60.
---
 libfprint/drivers/goodixtls/goodix53xd.c |  20 +++-
 libfprint/fp-image-device.c              |   5 +
 libfprint/fpi-image-device.c             |  12 +++
 libfprint/fpi-print.c                    |  19 +++-
 libfprint/fpi-print.h                    |   2 +
 libfprint/sigfm/img-info.hpp             |   2 +
 libfprint/sigfm/sigfm.cpp                | 122 ++++++++++++++++++++++-
 7 files changed, 174 insertions(+), 8 deletions(-)

diff --git a/libfprint/drivers/goodixtls/goodix53xd.c b/libfprint/drivers/goodixtls/goodix53xd.c
index 689ead2..d3de555 100644
--- a/libfprint/drivers/goodixtls/goodix53xd.c
+++ b/libfprint/drivers/goodixtls/goodix53xd.c
@@ -70,6 +70,8 @@
 #define GOODIX53XD_POLL_DELAY 100 // ms between two polled frames
 #define GOODIX53XD_FINGER_NOISE_FACTOR 4
 #define GOODIX53XD_FINGER_MIN_DELTA 16 // 12 bit units
+// Above this, the finger-free noise frame had a finger on it
+#define GOODIX53XD_MAX_BG_NOISE 64
 // A finger still landing gives a partial, blurry image: the capture waits
 // for the delta to the background to stop changing, then rejects presses
 // that are too light
@@ -77,7 +79,7 @@
 #define GOODIX53XD_SETTLE_MAX_POLLS 8
 #define GOODIX53XD_MIN_CONTACT_DELTA 1900 // $GOODIX53XD_MIN_CONTACT overrides
 // Each image only covers a small part of the finger
-#define GOODIX53XD_ENROLL_STAGES 20
+#define GOODIX53XD_ENROLL_STAGES 15
 #define GOODIX53XD_TEMPLATE_MAX 50
 // Verify scans with fewer SIFT keypoints, or a stronger signal, are asked
 // again: offline they caught half of the failed matches and almost no
@@ -889,6 +891,18 @@ static void scan_on_read_img(FpDevice* dev, guint8* data, guint16 len,
 
         decode_frame(frame, data);
         delta = frame_delta(frame, self->detect_img);
+        // A finger landing right after the calibration frames makes the
+        // "noise" frame a finger frame: the threshold would then be
+        // unreachable and the scan would hang. Calibrate again instead.
+        if (delta > GOODIX53XD_MAX_BG_NOISE) {
+            fp_dbg("Background noise %u too high (finger landing?), recalibrating",
+                   delta);
+            self->background_frames = 0;
+            self->dac_offset =
+                self->finger_dac_offset + GOODIX53XD_DETECT_DAC_STEP;
+            fpi_ssm_jump_to_state(ssm, SCAN_STAGE_WAIT);
+            return;
+        }
         self->finger_threshold = MAX(delta * GOODIX53XD_FINGER_NOISE_FACTOR,
                                      delta + GOODIX53XD_FINGER_MIN_DELTA);
         fp_dbg("Background noise: %u, finger threshold: %u", delta,
@@ -1311,11 +1325,11 @@ static void fpi_device_goodixtls53xd_class_init(
   img_dev_class->algorithm = FPI_DEVICE_ALGO_SIGFM;
   // Like the Goodix Windows engine: the template keeps up to 50 images,
   // matching scans being added to it
-  img_dev_class->sigfm_learn_max = GOODIX53XD_TEMPLATE_MAX;
+  img_dev_class->sigfm_learn_max = GOODIX53XD_TEMPLATE_MAX; // com trava FPRINT_LEARN_MIN (fpi-image-device.c)
   img_dev_class->sigfm_min_keypoints = GOODIX53XD_MIN_KEYPOINTS;
   // SIGFM score threshold. Offline, impostors never scored above 3 once the
   // fixed pattern of the sensor is removed by the calibration
-  img_dev_class->bz3_threshold = 10;
+  img_dev_class->bz3_threshold = 60; // correlação coerente x blocos x100 (dedo errado máx. 51 nos testes)
   img_dev_class->img_width = GOODIX53XD_IMG_WIDTH;
   img_dev_class->img_height = GOODIX53XD_IMG_HEIGHT;
 
