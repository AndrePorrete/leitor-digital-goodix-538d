+      {
+        fp_dbg ("Not learning: score %d < %d", fpi_print_sigfm_last_score (), learn_min);
+        return;
+      }
+  }
+
   fpi_print_sigfm_learn (template, print,
                          fp_device_get_nr_enroll_stages (FP_DEVICE (self)),
                          cls->sigfm_learn_max);
